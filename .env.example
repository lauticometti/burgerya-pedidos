# Copiar a .env (NUNCA commitear .env con valores reales).
# Las variables SIN prefijo VITE_ las lee api/**/*.js del lado del servidor
# (process.env) y nunca llegan al bundle del frontend. La unica excepcion a
# proposito es VITE_GOOGLE_MAPS_API_KEY (ver mas abajo): esa SI es publica.

# ==========================================================================
# PROVEEDOR ACTIVO: GOOGLE
# Se necesitan DOS keys distintas, en un proyecto de Google Cloud con
# facturacion activada.
# ==========================================================================

# --- Maps JavaScript API (el mapa) — key PUBLICA, va al navegador ---
# Es normal que quede visible en el bundle: asi funciona Maps JavaScript API.
# En Google Cloud restringila por "HTTP referrers" (http://localhost:5173/*
# en dev y el dominio real en produccion) y por API: SOLO "Maps JavaScript
# API". No hace falta habilitarle Places ni Geocoding.
VITE_GOOGLE_MAPS_API_KEY=

# --- Places API (New) + Geocoding API (busqueda y pin -> direccion) — SOLO servidor ---
# La usa unicamente api/location/*.js, despues de aplicar el rate limit.
# Nunca se envia al navegador. Key DISTINTA a la de arriba, SIN restriccion de
# referrer (las llamadas salen del servidor) y restringida por API a
# "Places API (New)" y "Geocoding API".
GOOGLE_PLACES_API_KEY=

# ==========================================================================
# PROVEEDOR ESTACIONADO: MAPBOX (no se usa; el codigo sigue en el repo)
# api/_lib/mapboxSearch.js y src/components/carrito/DeliveryMapboxMapPicker.jsx
# ==========================================================================
# VITE_MAPBOX_TOKEN=   (publico pk.*, mapa)
# MAPBOX_SEARCH_TOKEN=   (solo servidor, busqueda)

# ==========================================================================
# ANTIABUSO (independiente del proveedor)
# ==========================================================================

# --- Firma de la cookie de sesion (HMAC-SHA256) ---
# String random largo. Si falta en produccion, los endpoints de /api/location
# fallan cerrado (no se puede identificar sesion -> no se llama al proveedor).
# En dev local, si se omite, se usa un secreto fijo de desarrollo.
SESSION_SIGNING_SECRET=

# --- Upstash Redis (contadores persistentes/atomicos) ---
# Si se omiten, se usa un fallback en memoria del proceso — SOLO valido en
# dev local (npm run dev). En produccion real (Vercel) son obligatorias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Limites de uso (todos opcionales, estos son los defaults) ---
# Politica: una PERSONA que prueba direcciones a mano nunca queda cortada; solo
# se frena comportamiento imposible para una persona. Cada funcion (buscar,
# elegir una direccion, geocodificar el pin) tiene contadores y bloqueos PROPIOS.
# Toda proteccion responde 429 con un estado explicito (rate_limited /
# suspicious_activity) y un mensaje visible; cada rechazo deja en el log
# "[rate-limit] <estado> scope=<funcion> reason=<motivo>".
#
# BUSQUEDAS distintas por sesion en la ventana (un session token = una busqueda):
#   1..WARN: uso normal | WARN+1..BLOCK: se permite, se registra como uso alto |
#   mas de BLOCK: rate_limited.
RATE_LIMIT_WARN_SEARCHES=20
RATE_LIMIT_BLOCK_SEARCHES=40
# Ventana FIJA (segundos) en la que se cuentan las busquedas distintas.
RATE_LIMIT_WINDOW_SECONDS=600
# Espera tras pasar RATE_LIMIT_BLOCK_SEARCHES.
RATE_LIMIT_BLOCK_COOLDOWN_SECONDS=300
# Rafagas imposibles para una persona: mas de N busquedas distintas en X segundos
# (o mas de N pedidos por minuto) = suspicious_activity, con espera corta.
RATE_LIMIT_SEARCH_BURST_MAX=8
RATE_LIMIT_BURST_SECONDS=15
RATE_LIMIT_SEARCH_REQUESTS_PER_MINUTE=90
RATE_LIMIT_SUSPICIOUS_COOLDOWN_SECONDS=60
# Direcciones elegidas de la lista (retrieve): tope por ventana y por rafaga.
RATE_LIMIT_RETRIEVE_PER_WINDOW=60
RATE_LIMIT_RETRIEVE_BURST_MAX=12
# Cuantas sesiones NUEVAS puede crear una misma IP por hora (ojo: varios
# clientes detras de la misma IP de un operador movil comparten este cupo).
RATE_LIMIT_IP_NEW_SESSIONS_PER_HOUR=20

# --- Fusible global (obligatorio, con defaults conservadores) ---
MAX_ADDRESS_SEARCH_SESSIONS_PER_DAY=300
MAX_ADDRESS_SEARCH_SESSIONS_PER_MONTH=5000

# --- Geocodificacion inversa (pin -> direccion), topes propios (defaults) ---
# Consultas por sesion en la ventana (sostenido) y por rafaga, y la ventana en
# segundos. Contadores propios: no se comparten con las busquedas.
RATE_LIMIT_REVERSE_PER_WINDOW=60
RATE_LIMIT_REVERSE_BURST_MAX=15
RATE_LIMIT_REVERSE_WINDOW_SECONDS=600
# Fusible global de consultas por dia / mes: al llegar, no se llama mas a Google.
# Cada consulta es una llamada facturable a la Geocoding API: ajustar a lo que
# incluye el plan de Google.
MAX_REVERSE_LOOKUPS_PER_DAY=2000
MAX_REVERSE_LOOKUPS_PER_MONTH=30000
